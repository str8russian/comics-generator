{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comics-pipeline.local/storyboard-web/interpret-material-response.json",
  "title": "Material interpretation response",
  "description": "Ordered source items plus provisional characters and surface forms. This object contains no numeric offsets. sourceQuote and surfaceForms[].quote are non-authoritative copies. The server locates them in the draft. The model strings are not authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceItems", "characters", "surfaceForms"],
  "properties": {
    "sourceItems": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceItem" }
    },
    "characters": {
      "type": "array",
      "items": { "$ref": "#/$defs/character" }
    },
    "surfaceForms": {
      "type": "array",
      "items": { "$ref": "#/$defs/surfaceForm" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "speakerLabel": { "type": "string", "minLength": 1 },
    "sourceQuote": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Non-authoritative exact copy of this item's source slice, including a speaker label when that label is part of the slice."
    },
    "sourceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "segmentIds", "speakerStatus", "sourceQuote"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["utterance", "action", "context", "note"] },
        "segmentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^seg-[0-9]+$"
          }
        },
        "speakerStatus": { "enum": ["explicit", "inferred", "unresolved", "none"] },
        "speakerLabel": { "$ref": "#/$defs/speakerLabel" },
        "sourceQuote": { "$ref": "#/$defs/sourceQuote" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "utterance" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "speakerStatus": { "enum": ["explicit", "inferred", "unresolved"] }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["action", "context", "note"] } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "speakerStatus": { "const": "none" },
              "speakerLabel": false
            }
          }
        },
        {
          "if": {
            "properties": { "speakerStatus": { "enum": ["explicit", "inferred"] } },
            "required": ["speakerStatus"]
          },
          "then": {
            "required": ["speakerLabel"]
          }
        },
        {
          "if": {
            "properties": { "speakerStatus": { "enum": ["unresolved", "none"] } },
            "required": ["speakerStatus"]
          },
          "then": {
            "properties": { "speakerLabel": false }
          }
        }
      ]
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "surfaceForm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "quote", "role"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "quote": { "$ref": "#/$defs/sourceQuote" },
        "role": { "enum": ["speaker-label", "address", "mention"] },
        "characterId": { "$ref": "#/$defs/id" }
      }
    }
  }
}
