      "segmentIds": ["seg-7"],
      "speakerStatus": "explicit",
      "speakerLabel": "Песков",
      "sourceQuote": "Песков: Всем привет! Я использую WhatsApp!",
      "text": "Всем привет! Я использую WhatsApp!"
