{
  "name": "comics-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Server-side storyboard pipeline: schema, role prompts, validator, eval harness.",
  "scripts": {
    "golden": "node tools/build-golden.mjs",
    "validate": "node tools/validate.mjs",
    "metrics": "node tools/metrics.mjs",
    "mutations": "node tools/mutations.mjs",
    "check": "node tools/build-golden.mjs && node tools/validate.mjs golden/zayavka-full/storyboard.json && node tools/metrics.mjs golden/zayavka-full/storyboard.json",
    "spike:contest-api": "node --test spikes/contest-chat-completions/test/offline.test.mjs",
    "spike:contest-api:live": "node --env-file-if-exists=.env.local spikes/contest-chat-completions/live.mjs",
    "spike:image-api": "node --test spikes/image-api-diagnostics/test/offline.test.mjs spikes/image-api-diagnostics/test/payload-threshold.test.mjs",
    "spike:image-api:live": "node --env-file-if-exists=.env.local spikes/image-api-diagnostics/live.mjs",
    "spike:image-api:threshold": "node --env-file-if-exists=.env.local spikes/image-api-diagnostics/threshold.mjs",
    "spike:image-api:under-limit": "node --env-file-if-exists=.env.local spikes/image-api-diagnostics/under-limit.mjs",
    "spike:image-api:limit-check": "node --env-file-if-exists=.env.local spikes/image-api-diagnostics/limit-check.mjs",
    "spike:image-api:payload-threshold": "node --env-file-if-exists=.env.local spikes/image-api-diagnostics/payload-threshold.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pg": "^8.23.1",
    "sharp": "^0.34.4"
  },
  "engines": {
    "node": ">=24"
  }
}
