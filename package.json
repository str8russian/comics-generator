{
  "name": "comics-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Server-side storyboard pipeline: schema, role prompts, validator, eval harness.",
  "scripts": {
    "golden": "node tools/build-golden.mjs",
    "validate": "node tools/validate.mjs",
    "metrics": "node tools/metrics.mjs",
    "mutations": "node tools/mutations.mjs",
    "check": "node tools/build-golden.mjs && node tools/validate.mjs golden/zayavka-full/storyboard.json && node tools/metrics.mjs golden/zayavka-full/storyboard.json",
    "spike:contest-api": "node --test spikes/contest-chat-completions/test/offline.test.mjs",
    "spike:contest-api:live": "node --env-file-if-exists=.env.local spikes/contest-chat-completions/live.mjs",
    "spike:image-api": "node --test spikes/image-api-diagnostics/test/offline.test.mjs spikes/image-api-diagnostics/test/payload-threshold.test.mjs spikes/image-api-diagnostics/test/image-threshold.test.mjs",
    "spike:image-api:live": "node --env-file-if-exists=.env.local spikes/image-api-diagnostics/live.mjs",
    "spike:image-api:threshold": "node --env-file-if-exists=.env.local spikes/image-api-diagnostics/threshold.mjs",
    "spike:image-api:under-limit": "node --env-file-if-exists=.env.local spikes/image-api-diagnostics/under-limit.mjs",
    "spike:image-api:limit-check": "node --env-file-if-exists=.env.local spikes/image-api-diagnostics/limit-check.mjs",
    "spike:image-api:payload-threshold": "node --env-file-if-exists=.env.local spikes/image-api-diagnostics/payload-threshold.mjs",
    "spike:image-api:image-threshold": "node --env-file-if-exists=.env.local spikes/image-api-diagnostics/image-threshold.mjs",
    "spike:base-anchor-ui": "node --test spikes/base-anchor-ui-prototype/test/*.test.mjs",
    "spike:style-determinism": "node --test spikes/style-determinism-generation/test/*.test.mjs",
    "spike:style-determinism:manifest": "node spikes/style-determinism-generation/write-runtime-manifest.mjs",
    "spike:style-determinism:check": "node --env-file-if-exists=.env.local spikes/style-determinism-generation/live.mjs --check",
    "spike:style-determinism:fake": "node spikes/style-determinism-generation/live.mjs --fake",
    "spike:style-determinism:live": "node --env-file-if-exists=.env.local spikes/style-determinism-generation/live.mjs",
    "spike:style-determinism:review": "node spikes/style-determinism-generation/review.mjs",
    "spike:style-determinism:backfill": "node spikes/style-determinism-generation/backfill-inputs.mjs",
    "spike:style-determinism:recover": "node --env-file-if-exists=.env.local spikes/style-determinism-generation/recover.mjs",
    "spike:style-determinism:cross-identity:manifest": "node spikes/style-determinism-generation/write-runtime-manifest.mjs --profile cross-identity",
    "spike:style-determinism:cross-identity:check": "node --env-file-if-exists=.env.local spikes/style-determinism-generation/live.mjs --profile cross-identity --check",
    "spike:style-determinism:cross-identity:fake": "node spikes/style-determinism-generation/live.mjs --profile cross-identity --fake",
    "spike:style-determinism:cross-identity:live": "node --env-file-if-exists=.env.local spikes/style-determinism-generation/live.mjs --profile cross-identity",
    "spike:style-determinism:cross-identity:review": "node spikes/style-determinism-generation/review.mjs --profile cross-identity"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pg": "^8.23.1",
    "sharp": "^0.34.4"
  },
  "engines": {
    "node": ">=24"
  }
}
